import "tfplan/v2" as tfplan

# Define allowed values for the Environment tag
allowed_envs = ["dev", "staging", "prod"]

main = rule {
  all tfplan.resources.aws_instance as _, instances {
    all instances as _, instance {
      # Ensure the Environment tag exists
      "Environment" in instance.applied.tags and
      # Ensure the value is one of the allowed_envs
      instance.applied.tags["Environment"] in allowed_envs
    }
  }
}
